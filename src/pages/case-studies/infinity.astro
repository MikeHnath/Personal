  .infinity-social img{max-width:80%}
  .infinity-amazon img{background:transparent;border-radius:0}
  .infinity-store-social{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}
  .infinity-store-social .store-social-cell{display:flex;flex-direction:column;gap:10px;min-width:0}
  @media (max-width:640px){
    .infinity-store-social{gap:8px}
  }

  .infinity-bottle-section{padding-top:20px;padding-bottom:20px}

  .infinity-decks-section{padding-left:0;padding-right:0}
  @media (min-width:641px){
    .infinity-decks-section{
      width:100cqi;
      margin-left:calc(50% - 50cqi);
      margin-right:calc(50% - 50cqi);
      box-sizing:border-box;
    }
  }
  @media (max-width:640px){
    .infinity-decks-section{padding-left:21px;padding-right:21px}
  }
  .infinity-deck-tickers{display:flex;flex-direction:column;gap:16px;padding-top:24px;padding-bottom:24px}
  .deck-ticker{position:relative;overflow:hidden;-webkit-mask-image:linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%);mask-image:linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%)}
  .deck-ticker-track{display:flex;gap:20px;width:max-content;will-change:transform}
  .deck-ticker-track--left{animation:deck-scroll-left var(--deck-dur, 60s) linear infinite}
  .deck-ticker-track--right{animation:deck-scroll-right var(--deck-dur, 60s) linear infinite}
  .deck-ticker-track img{display:block;height:153px;width:auto;border-radius:4px;box-shadow:0 1px 4px rgba(0,0,0,.18);background:var(--bg2);flex-shrink:0;pointer-events:none;user-select:none;-webkit-user-drag:none}
  @keyframes deck-scroll-left{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes deck-scroll-right{from{transform:translateX(-50%)}to{transform:translateX(0)}}
  @media (max-width:640px){
    .deck-ticker-track img{height:119px}
