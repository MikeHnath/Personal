---
interface Props {
  lines?: number;
  opacity?: number;
  speed?: number;
  amplitude?: number;
  class?: string;
}

const {
  lines = 12,
  opacity = 0.15,
  speed = 0.4,
  amplitude = 60,
  class: className = ''
} = Astro.props;
---

<canvas
  class={`waveform-canvas ${className}`.trim()}
  data-lines={lines}
  data-opacity={opacity}
  data-speed={speed}
  data-amplitude={amplitude}
  aria-hidden="true"
  style="color:var(--text)"
></canvas>

<style>
  .waveform-canvas{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    pointer-events:none;
    display:block;
  }
</style>

<script>
  function parseColor(color: string): [number, number, number] {
    const m = color.match(/-?\d+(\.\d+)?/g);
    if (!m || m.length < 3) return [0, 0, 0];
    return [+m[0], +m[1], +m[2]];
  }

  function initWaveform(canvas: HTMLCanvasElement) {
    if (canvas.dataset.wfInited) return;
    canvas.dataset.wfInited = '1';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const connectorCount = Math.max(4, +(canvas.dataset.lines || 12));
    const opacity = +(canvas.dataset.opacity || 0.15);
    const speed = +(canvas.dataset.speed || 0.4);
    const amplitude = +(canvas.dataset.amplitude || 60);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
    };
    resize();

    let strokeRGB: [number, number, number] = [0, 0, 0];
    const refreshColor = () => {
      const c = getComputedStyle(canvas).color;
      const [r, g, b] = parseColor(c);
      // Keep close to source brightness with just a faint blue lift,
      // so the result reads as near-white in dark mode.
      const tR = r * 0.75;
      const tG = g * 0.85;
      const tB = b * 1.1 + 10;
      // Desaturate toward luminance — 0 = pure gray, 1 = full color.
      const sat = 0.3;
      const lum = tR * 0.299 + tG * 0.587 + tB * 0.114;
      strokeRGB = [
        Math.max(0, Math.min(255, lum + (tR - lum) * sat)),
        Math.max(0, Math.min(255, lum + (tG - lum) * sat)),
        Math.max(0, Math.min(255, lum + (tB - lum) * sat))
      ];
    };
    refreshColor();

    const themeObs = new MutationObserver(refreshColor);
    themeObs.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });

    const ro = new ResizeObserver(() => resize());
    ro.observe(canvas);

    let raf = 0;
    let running = !reduce;
    const t0 = performance.now();

    const zCache: Record<number, Float32Array> = {};
    const buildZ = (count: number): Float32Array => {
      const arr = new Float32Array(count);
      for (let i = 0; i < count; i++) {
        const h = Math.sin((i + 1) * 12.9898) * 43758.5453;
        arr[i] = (h - Math.floor(h)) * 2 - 1;
      }
      return arr;
    };

    const yWave = (
      x: number,
      ts: number,
      phase: number,
      sign: number,
      ampMul: number = 1,
      cyOff: number = 0,
      freqMul: number = 1
    ): number => {
      const cy = height / 2 + cyOff;
      const freq = 0.0022 * freqMul;
      const amp = amplitude * ampMul;
      return (
        cy +
        amp *
          0.85 *
          Math.sin(x * freq + ts * sign + phase) +
        amp *
          0.22 *
          Math.sin(x * freq * 2.3 + ts * sign * 1.4 + phase * 0.6 + 1.1)
      );
    };

    const drawFrame = (t: number) => {
      const ts = ((t - t0) / 1000) * speed;
      ctx.clearRect(0, 0, width, height);

      const step = Math.max(2, Math.floor(width / 240));
      const r = strokeRGB[0];
      const g = strokeRGB[1];
      const b = strokeRGB[2];
      const maxGap = amplitude * 2;

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Stack of parallel waves between the two envelopes — each
      // intermediate line is a linear interpolation of yA and yB at
      // the same x, so they all run in parallel with the main
      // waves, and they collapse where the two cross (the ribbon's
      // edge fold).
      const totalLines = connectorCount + 2;

      // Pre-sample the three main envelopes once per frame.
      const sampleCount = Math.floor(width / step) + 1;
      const aSamples = new Float32Array(sampleCount);
      const cSamples = new Float32Array(sampleCount);
      const bSamples = new Float32Array(sampleCount);
      // a (front/top) and b (back/bottom) are small waves confined to
      // non-overlapping upper and lower bands, so they never cross.
      // c (middle) is a low-frequency wide-amplitude sweep that crosses
      // a's band once and b's band once — giving 2 total intersections.
      const cFreq = 0.0022 * 0.45;
      const cAmp = amplitude * 0.75;
      for (let s = 0; s < sampleCount; s++) {
        const x = s * step;
        aSamples[s] = yWave(x, ts, 0.0, 1, 0.18, -amplitude * 0.5);
        bSamples[s] = yWave(x, ts, Math.PI, -1, 0.18, amplitude * 0.5);
        cSamples[s] = height / 2 + cAmp * Math.sin(x * cFreq + ts);
      }

      const half = 1 / 2;

      for (let i = 0; i < totalLines; i++) {
        const tI = totalLines === 1 ? 0.5 : i / (totalLines - 1);
        // distance to the nearest main line (positions 0, 1/2, 1)
        const distToMain = Math.min(
          Math.abs(tI - 0),
          Math.abs(tI - half),
          Math.abs(tI - 1)
        );
        // Per-line depth (z): pseudo-random in [-1, 1], stable per index.
        // |z| ≈ 0 = focal plane (sharp/front), |z| ≈ 1 = far (soft/back).
        const zValues = zCache[totalLines] || buildZ(totalLines);
        zCache[totalLines] = zValues;
        const absZ = Math.abs(zValues[i]);
        // mains sit at base opacity; intermediates fade nearly to bg.
        // Back lines fade further; front lines stay full strength.
        const baseA = opacity * Math.max(0.04, 1 - distToMain * 6);
        const a = baseA * (1 - absZ * 0.4375);
        ctx.strokeStyle = `rgba(${r},${g},${b},${a})`;
        // Front lines are noticeably thicker, back lines hair-thin.
        ctx.lineWidth = 0.20 + (1 - absZ) * 3.30;
        // Soft blur only on lines further from the focal plane.
        // Quadratic ramp keeps most lines crisp; only the back ~third blurs.
        const blur = absZ > 0.35 ? (absZ - 0.35) * (absZ - 0.35) * 5.5 : 0;
        if (blur > 0) {
          ctx.shadowBlur = blur;
          ctx.shadowColor = `rgba(${r},${g},${b},${a})`;
        } else {
          ctx.shadowBlur = 0;
        }
        ctx.beginPath();
        for (let s = 0; s < sampleCount; s++) {
          const x = s * step;
          let y: number;
          if (tI <= half) {
            const t2 = tI * 2;
            y = aSamples[s] * (1 - t2) + cSamples[s] * t2;
          } else {
            const t2 = (tI - half) * 2;
            y = cSamples[s] * (1 - t2) + bSamples[s] * t2;
          }
          if (s === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      ctx.shadowBlur = 0;

      // Edge fade — trim alpha at left/right
      ctx.save();
      ctx.globalCompositeOperation = 'destination-in';
      const fadeWidth = Math.min(140, width * 0.18);
      const grad = ctx.createLinearGradient(0, 0, width, 0);
      grad.addColorStop(0, 'rgba(0,0,0,0)');
      grad.addColorStop(Math.min(0.499, fadeWidth / Math.max(width, 1)), 'rgba(0,0,0,1)');
      grad.addColorStop(Math.max(0.501, 1 - fadeWidth / Math.max(width, 1)), 'rgba(0,0,0,1)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);
      ctx.restore();

      if (running) raf = requestAnimationFrame(drawFrame);
    };

    if (running) {
      raf = requestAnimationFrame(drawFrame);
    } else {
      drawFrame(performance.now());
    }

    const onVisibility = () => {
      if (reduce) return;
      if (document.hidden) {
        running = false;
        cancelAnimationFrame(raf);
      } else if (!running) {
        running = true;
        raf = requestAnimationFrame(drawFrame);
      }
    };
    document.addEventListener('visibilitychange', onVisibility);
  }

  const boot = () => {
    document
      .querySelectorAll<HTMLCanvasElement>('canvas.waveform-canvas')
      .forEach(initWaveform);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
